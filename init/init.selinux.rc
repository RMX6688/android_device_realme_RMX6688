# Per-domain counterpart of BOARD_BOOTCONFIG's androidboot.selinux=permissive,
# which is not present when the running boot image is not ours (DSU testing).
# The script needs a permissive domain, see sepolicy/vendor/setenforce_sh.te.

service selinux_permissive /vendor/bin/sh /vendor/bin/init.selinux.sh
    class core
    user root
    group root system
    seclabel u:r:setenforce_sh:s0
    file /dev/kmsg w
    oneshot
    disabled

on early-init
    start selinux_permissive
