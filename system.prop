# Audio
audio.offload.disable=1
ro.audio.flinger_standbytime_ms=1000
ro.audio.ihaladaptervendorextension_enabled=true
ro.audio.silent=0
ro.audio.spatializer_enabled=true
ro.audio.spatializer_type=oplus
ro.audio.usb.period_us=16000

# Bluetooth
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.hfp.ag.enabled=true

# Display
ro.lib_gui.frame_event_history_size=16

# Logging
ro.vendor.customer_logpath=/data

# Radio
persist.radio.hvolte.enable=1
ro.mediatek.version.branch=alps-mp-b0.mssi1.tc16sp-pr1
vendor.rild.libargs=-d /dev/ttyC0
vendor.rild.libpath=mtk-ril.so
