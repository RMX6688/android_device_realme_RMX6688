# init

# Device nodes
allow init ccci_ccb_device:chr_file rw_file_perms;
allow init ccci_device:chr_file rw_file_perms;
allow init ccci_mdl_device:chr_file rw_file_perms;
allow init mobicore_user_device:chr_file rw_file_perms;
allow init ttyS_device:chr_file rw_file_perms;
allow init uhid_device:chr_file rw_file_perms;
allow init oplus_consumer_ir_device:chr_file rw_file_perms;
allow init oplus_display_device:chr_file rw_file_perms;
allow init tcm_hbp_device:chr_file rw_file_perms;
allow init awinic_haptic_device:chr_file rw_file_perms;
allow init fingerprint_device:chr_file rw_file_perms;
allow init ssc_interactive_device:chr_file rw_file_perms;

# sysfs / proc / debugfs
allow vendor_init debugfs_tracing_instances:file create_file_perms;
allow init sysfs_boot_info:file r_file_perms;
allow init sysfs_ccci:file r_file_perms;
allow init proc:file { getattr open read write };
allow init proc_bus_input:file r_file_perms;
allow init debugfs_bootreceiver_tracing:dir { add_name search write };
allow init debugfs_bootreceiver_tracing:file create_file_perms;
allow init debugfs_tracing_instances:file create_file_perms;

# Data
allow init mdlog_data_file:file { append create getattr open read rename setattr write };
allow init vendor_data_file:file { append create write };

# Executables
allow init vendor_file:file execute;
allow init same_process_hal_file:file execute;

# capability / socket
allow init self:capability { ipc_lock sys_nice };
allow init self:netlink_kobject_uevent_socket { bind create getopt read setopt };
allow init self:netlink_socket { bind create read write };
allow init self:netlink_generic_socket { bind create read write };
allow init socket_device:sock_file { create setattr unlink };


# vendor_init
allow vendor_init proc:file write;

# restorecon /mnt/vendor/persist/camera
allow init oplus_persist_camera_file:dir { relabelto getattr search open read };
allow init oplus_persist_camera_file:file { relabelto getattr open read };
