# Domain of the early-init SELinux-disable script (init/init.selinux.sh).
#
# Writing /sys/fs/selinux/enforce hits the neverallowed `setenforce` check, so the
# write is only permitted from a permissive domain -- the same escape hatch AOSP
# uses for su (system/sepolicy/private/su.te). No allow rules are needed.

type setenforce_sh, domain;
type setenforce_sh_exec, exec_type, vendor_file_type, file_type;

permissive setenforce_sh;

init_daemon_domain(setenforce_sh)
