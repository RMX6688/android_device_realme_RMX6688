# Display

allow hal_graphics_composer_default mnt_vendor_file:dir search;
allow hal_graphics_composer_default persist_data_file:dir search;
allow hal_graphics_composer_default persist_data_file:file r_file_perms;
allow hal_graphics_composer_default sysfs:file r_file_perms;
allow hal_graphics_composer_default proc:file r_file_perms;
allow hal_graphics_composer_default fwk_sensor_service:service_manager find;
allow hal_graphics_composer_default hal_graphics_composer_service:service_manager add;
allow hal_graphics_composer_default oplus_display_device:chr_file rw_file_perms;
allow hal_graphics_composer_default oplus_display_data_file:dir { open getattr read search add_name write remove_name };
allow hal_graphics_composer_default oplus_display_data_file:file { create rename setattr unlink open getattr read write append map };

# PQ / mmlpq
allow mtk_hal_pq proc:file r_file_perms;
get_prop(mtk_hal_mmlpq, boot_status_prop)

allow hal_graphics_composer_default hal_oplus_services_service:service_manager add;
